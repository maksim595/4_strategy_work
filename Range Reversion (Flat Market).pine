//@version=6
indicator("Range Reversion (Flat Market)", overlay=true)

// ─── Настройки ───
adxLen    = input.int(14, "ADX Length", minval=1, maxval=100)
adxThr    = input.float(20.0, "ADX Threshold (below = flat)", minval=10, maxval=40, step=1.0)
bbLen     = input.int(20, "BB Length", minval=1, maxval=100)
bbMult    = input.float(2.0, "BB StdDev", minval=0.5, maxval=5.0, step=0.1)
rsiLen    = input.int(14, "RSI Length", minval=1, maxval=100)
rsiOS     = input.float(30.0, "RSI Oversold", minval=10, maxval=40, step=1.0)
rsiOB     = input.float(70.0, "RSI Overbought", minval=60, maxval=90, step=1.0)

// ─── Расчёты ───
[diPlus, diMinus, adxVal] = ta.dmi(adxLen, adxLen)
rsiVal = ta.rsi(close, rsiLen)

basis = ta.sma(close, bbLen)
dev   = bbMult * ta.stdev(close, bbLen)
upper = basis + dev
lower = basis - dev

// Ширина полос и её средняя (для детектора сжатия)
bbWidth    = (upper - lower) / basis * 100
bbWidthAvg = ta.sma(bbWidth, 20)

// ─── Условия ───
// Флэт: ADX слабый + полосы не расширяются (сжатие или стабильность)
isFlat = adxVal < adxThr and bbWidth <= bbWidthAvg * 1.1

// Сигналы возврата к среднему (только во флэте!)
buySignal  = isFlat and (low <= lower or close <= lower) and rsiVal < rsiOS
sellSignal = isFlat and (high >= upper or close >= upper) and rsiVal > rsiOB

// ─── Якорь для отрисовки (обязательно!) ───
plot(buySignal  ? low  : na, "BuyAnchor",  color=color.new(color.green, 100), display=display.none)
plot(sellSignal ? high : na, "SellAnchor", color=color.new(color.red,   100), display=display.none)

// ─── Маркеры BUY/SELL ───
plotshape(buySignal,  "BUY",  shape.labelup,   location.belowbar, color=color.green, text="BUY",  size=size.small)
plotshape(sellSignal, "SELL", shape.labeldown, location.abovebar, color=color.red,   text="SELL", size=size.small)

// ─── Визуализация (опционально) ───
plot(basis, "BB Basis", color=color.gray)
plot(upper, "BB Upper", color=color.red)
plot(lower, "BB Lower", color=color.green)
//@version=6
indicator("EMA Cross + Volume Signal", overlay=true)

fastLen    = input.int(9,  "Fast EMA", minval=1, maxval=100)
slowLen    = input.int(21, "Slow EMA", minval=1, maxval=200)
volLen     = input.int(20, "Volume MA Length", minval=1, maxval=200)
volMult    = input.float(1.2, "Volume Multiplier", minval=0.1, maxval=5.0, step=0.1)

fastEma = ta.ema(close, fastLen)
slowEma = ta.ema(close, slowLen)
volMa   = ta.sma(volume, volLen)
volFilter = volume > volMa * volMult

buySignal  = ta.crossover(fastEma, slowEma) and volFilter
sellSignal = ta.crossunder(fastEma, slowEma) and volFilter

plot(fastEma, "Fast EMA", color=color.aqua,   linewidth=2)
plot(slowEma, "Slow EMA", color=color.yellow, linewidth=2)

plot(buySignal  ? low  : na, "BuyAnchor",  color=color.new(color.green, 100), display=display.none)
plot(sellSignal ? high : na, "SellAnchor", color=color.new(color.red,   100), display=display.none)
plotshape(buySignal,  "BUY",  shape.labelup,   location.belowbar, color=color.green, text="BUY",  size=size.small)
plotshape(sellSignal, "SELL", shape.labeldown, location.abovebar, color=color.red,   text="SELL", size=size.small)
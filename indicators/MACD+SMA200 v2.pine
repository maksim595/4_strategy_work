//@version=6
indicator("MACD + SMA200 Signal", overlay=true)

fastLen  = input.int(12, "MACD Fast", minval=1, maxval=100)
slowLen  = input.int(26, "MACD Slow", minval=2, maxval=200)
sigLen   = input.int(9,  "MACD Signal", minval=1, maxval=100)
smaLen   = input.int(200,"SMA Filter Length", minval=1, maxval=500)

[macdLine, signalLine, _] = ta.macd(close, fastLen, slowLen, sigLen)
smaFilter = ta.sma(close, smaLen)

buySignal  = ta.crossover(macdLine, signalLine)  and close > smaFilter
sellSignal = ta.crossunder(macdLine, signalLine) and close < smaFilter

plot(smaFilter, "SMA Filter", color=color.gray, linewidth=2)

plot(buySignal  ? low  : na, "BuyAnchor",  color=color.new(color.green, 100), display=display.none)
plot(sellSignal ? high : na, "SellAnchor", color=color.new(color.red,   100), display=display.none)
plotshape(buySignal,  "BUY",  shape.labelup,   location.belowbar, color=color.green, text="BUY",  size=size.small)
plotshape(sellSignal, "SELL", shape.labeldown, location.abovebar, color=color.red,   text="SELL", size=size.small)
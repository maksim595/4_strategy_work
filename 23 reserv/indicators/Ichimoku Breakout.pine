//@version=6
indicator("Ichimoku Breakout Signal", overlay=true)

tenkan = (ta.highest(high, 9)  + ta.lowest(low, 9))  / 2
kijun  = (ta.highest(high, 26) + ta.lowest(low, 26)) / 2
senkouA = (tenkan + kijun) / 2
senkouB = (ta.highest(high, 52) + ta.lowest(low, 52)) / 2

cloudTop = math.max(senkouA, senkouB)
cloudBot = math.min(senkouA, senkouB)

buySignal  = close > cloudTop and tenkan > kijun
sellSignal = close < cloudBot and tenkan < kijun

plot(tenkan, "Tenkan", color=color.blue)
plot(kijun,  "Kijun",  color=color.red)

plot(buySignal  ? low  : na, "BuyAnchor",  color=color.new(color.green, 100), display=display.none)
plot(sellSignal ? high : na, "SellAnchor", color=color.new(color.red,   100), display=display.none)

plotshape(buySignal,  "BUY",  shape.labelup,   location.belowbar, color=color.green, text="BUY",  size=size.small)
plotshape(sellSignal, "SELL", shape.labeldown, location.abovebar, color=color.red,   text="SELL", size=size.small)
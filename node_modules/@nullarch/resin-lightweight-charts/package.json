{
  "name": "@nullarch/resin-lightweight-charts",
  "version": "0.1.0",
  "description": "Render @nullarch/resin visualization output on TradingView's lightweight-charts",
  "license": "Apache-2.0",
  "type": "module",
  "keywords": [
    "pinescript",
    "pine-script",
    "tradingview",
    "lightweight-charts",
    "resin",
    "charting"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nullarch/resin-lightweight-charts.git"
  },
  "bugs": "https://github.com/nullarch/resin-lightweight-charts/issues",
  "homepage": "https://github.com/nullarch/resin-lightweight-charts#readme",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "lightweight-charts": "^5.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "gen:fixtures": "node tests/gen-fixtures.mjs",
    "prepublishOnly": "npm run build",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "@nullarch/resin": "github:nullarch/resin",
    "@types/node": "^26.2.0",
    "lightweight-charts": "^5.0.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
//@version=6
indicator("Chandelier Exit Signal", overlay=true)

lookback  = input.int(22, "Lookback Period", minval=1, maxval=200)
atrPeriod = input.int(22, "ATR Period", minval=1, maxval=200)
atrMult   = input.float(3.0, "ATR Multiplier", minval=0.1, maxval=10.0, step=0.1)

atr       = ta.atr(atrPeriod)
longStop  = ta.highest(high, lookback) - atr * atrMult
shortStop = ta.lowest(low, lookback)   + atr * atrMult

var float chandelierLong  = na
var float chandelierShort = na
chandelierLong  := close > nz(chandelierLong[1], 0)  ? math.max(longStop,  nz(chandelierLong[1],  longStop))  : longStop
chandelierShort := close < nz(chandelierShort[1], 0) ? math.min(shortStop, nz(chandelierShort[1], shortStop)) : shortStop

buySignal  = ta.crossover(close, chandelierLong)
sellSignal = ta.crossunder(close, chandelierShort)

plot(chandelierLong,  "Long Stop",  color=color.green, linewidth=2)
plot(chandelierShort, "Short Stop", color=color.red,   linewidth=2)

plot(buySignal  ? low  : na, "BuyAnchor",  color=color.new(color.green, 100), display=display.none)
plot(sellSignal ? high : na, "SellAnchor", color=color.new(color.red,   100), display=display.none)
plotshape(buySignal,  "BUY",  shape.labelup,   location.belowbar, color=color.green, text="BUY",  size=size.small)
plotshape(sellSignal, "SELL", shape.labeldown, location.abovebar, color=color.red,   text="SELL", size=size.small)